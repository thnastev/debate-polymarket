    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.0.1",
    "pg": "^8.12.0",
    "playwright": "^1.48.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
